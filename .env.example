# ==============================================================
# Enterprise Corrective RAG (CRAG) Environment Configuration
# ==============================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GOOGLE_API_KEY=

# Gemini Models
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Vector DB Configuration (local on-disk path or :memory:)
QDRANT_LOCATION=./qdrant_storage
QDRANT_COLLECTION=enterprise_crag_corpus

# Ingestion Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval & Reranker Settings
TOP_K_RETRIEVAL=8
TOP_N_RERANK=3
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Agentic Cycle Guardrails
MAX_REWRITES=2

# Test / Mock Mode (set to False for live Gemini API calls)
MOCK_MODE=False
